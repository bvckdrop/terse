{
  "description": "Terse: inject ruleset at session start, per-prompt anchor, subagent digest.",
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
          "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/anchor.sh\"",
          "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Task|Agent",
        "hooks": [
        { "type": "command",
          "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent.sh\"",
          "timeout": 5 } ] }
    ]
  }
}
